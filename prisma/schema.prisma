generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Models ───────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  locale          String    @default("en")
  role            String    @default("user")
  preferenceStyle String?
  emailShipping   Boolean   @default(true)
  emailMarketing  Boolean   @default(true)
  emailReferral   Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  stripeCustomer      StripeCustomer?
  subscription        Subscription?
  addresses           Address[]
  ritualProgress      RitualProgress[]
  wishlistItems       WishlistItem[]
  referral            Referral?
  referralRedemptions ReferralRedemption[]
  orders              Order[]
  fulfillmentFlags    FulfillmentFlag[]
  analyticsEvents     AnalyticsEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Stripe / Billing ─────────────────────────────────────────

model StripeCustomer {
  id               String @id @default(cuid())
  userId           String @unique
  stripeCustomerId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  lastInvoiceStatus    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  createdAt     DateTime @default(now())
}

// ─── Shipping ─────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  country    String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Analytics ────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  locale    String
  variant   String?
  eventName String
  propsJson String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([createdAt])
  @@index([sessionId])
}

// ─── Ritual Engine ────────────────────────────────────────────

model RitualPrompt {
  id         String @id @default(cuid())
  locale     String
  weekNumber Int
  title      String
  promptText String @db.Text
  themeMonth String

  @@unique([locale, weekNumber, themeMonth])
}

model RitualProgress {
  id          String   @id @default(cuid())
  userId      String
  weekNumber  Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
}

// ─── Past Box Vault ───────────────────────────────────────────

model VaultItem {
  id          String @id @default(cuid())
  locale      String
  title       String
  description String @db.Text
  month       String
  imageUrl    String?

  wishlistItems WishlistItem[]

  @@unique([locale, month, title])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  vaultItemId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vaultItemId])
}

// ─── Referrals ────────────────────────────────────────────────

model Referral {
  code        String   @id
  ownerUserId String   @unique
  createdAt   DateTime @default(now())

  owner       User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]
}

model ReferralRedemption {
  id                 String    @id @default(cuid())
  referralCode       String
  redeemedByUserId   String
  createdAt          DateTime  @default(now())
  firstInvoicePaidAt DateTime?

  referral   Referral @relation(fields: [referralCode], references: [code], onDelete: Cascade)
  redeemedBy User     @relation(fields: [redeemedByUserId], references: [id], onDelete: Cascade)

  @@unique([referralCode, redeemedByUserId])
}

// ─── Orders & Fulfillment ─────────────────────────────────────

model Order {
  id             String    @id @default(cuid())
  userId         String
  month          String
  theme          String?
  status         String    @default("pending")
  shippedAt      DateTime?
  trackingNumber String?
  createdAt      DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfillmentCost FulfillmentCost?
}

model FulfillmentCost {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  carrier               String?
  service               String?
  actualShippingCostUSD Float
  createdAt             DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model FulfillmentFlag {
  id        String   @id @default(cuid())
  userId    String
  month     String
  flagType  String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, flagType])
}
